# Optional. Every value has a working default; on Unraid set these in the Docker tab.
TZ=Europe/Amsterdam
PUID=99
PGID=100
# OpenAI key for the logo generator (can also be entered in Settings)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Force Secure cookies even behind a proxy that does not send X-Forwarded-Proto
# COOKIE_SECURE=true
# Default theme for new installs: daylight, midnight, nord, sand, forest
DEFAULT_THEME=midnight
# BACKUP_ENABLED=true
# BACKUP_KEEP=7
